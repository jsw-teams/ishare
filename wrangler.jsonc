{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ishare",
  "main": "backend/ishare/adapters/cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "OWNER_GITHUB_ID": "228026986",
    "SHIELD_ALLOWED_HOSTS": [
      "ishare.js.gripe"
    ]
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/rss.xml",
      "/feed.xml",
      "/en/rss.xml",
      "/zh-CN/rss.xml",
      "/zh-TW/rss.xml",
      "/u/*",
      "/auth",
      "/auth/callback",
      "/oembed",
      "/s/*",
      "/embed/*",
      "/i/*",
      "/v/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARE_STORE",
        "class_name": "ShareStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ishare-v1",
      "new_sqlite_classes": [
        "ShareStore"
      ]
    }
  ],
  "send_metrics": false
}
