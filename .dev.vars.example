# Actual values belong in local .dev.vars and production Worker Secrets.
# Resource accounts may differ from each other and from the Worker account.
IMAGES_ACCOUNT_ID=
IMAGES_API_TOKEN=
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
STREAM_CUSTOMER_CODE=
# Optional local signing avoids the cached Stream token API. Set both together.
STREAM_SIGNING_KEY_ID=
# Base64-encoded JWK returned by Cloudflare Stream signing-key creation.
STREAM_SIGNING_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNER_GITHUB_ID=228026986
# Optional additional administrators, as comma-separated numeric IDs.
ADMIN_IDS=
# Empty permits authenticated publishers subject to quotas.
PUBLISHER_IDS=
