  },
  "overrides": {
    "@file-viewer/doc": {
      "dompurify": "3.4.16"
    }
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "lucide-static": "1.52.0",
    "playwright": "^1.63.0",
    "wrangler": "^4.149.0"
  },
  "version": "202610.4.0"
}
