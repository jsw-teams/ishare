  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:cloudflare": "npm run deploy",
    "icons:sync": "node tools/sync-icons.mjs",
    "pages:format": "node tools/assets/format-pages.mjs",
    "test:data-saver": "node --test tests/data-saver-site.test.mjs",
    "verify:performance": "node tools/verification/page-performance.mjs"
  },
  "dependencies": {
    "@jsw-teams/media-viewer": "https://codeload.github.com/jsw-teams/media-viewer/tar.gz/158ca150b221b4da0058b61d87c8d3ca787ebf25",
